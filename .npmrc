auto-install-peers=false
strict-peer-dependencies=false

# Expo + pnpm: Babel presets/plugins must be hoisted so @babel/core can resolve
# them regardless of which node_modules context it runs from (e.g. Metro worker)
public-hoist-pattern[]=babel-preset-expo
public-hoist-pattern[]=*babel-plugin*
public-hoist-pattern[]=@babel/plugin-*
public-hoist-pattern[]=@babel/preset-*
